rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role in ['owner', 'staff'];
    }

    function isWorker() {
      return isSignedIn() && userDoc().data.role == 'worker';
    }

    function validShop() {
      return request.resource.data.shopId == 'rattan-electricals';
    }

    match /qrLinks/{token} {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /customers/{id} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() && validShop())
        || (request.auth == null && validShop());
      allow update: if isAdmin()
        || (request.auth == null && validShop());
    }

    match /serviceRequests/{id} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() && validShop())
        || (request.auth == null
          && validShop()
          && request.resource.data.status == 'new'
          && request.resource.data.keys().hasAll(['customerId', 'problemType', 'description', 'referenceCode'])
          && exists(/databases/$(database)/documents/qrLinks/$(request.resource.data.qrToken))
          && get(/databases/$(database)/documents/qrLinks/$(request.resource.data.qrToken)).data.active == true);
      allow update, delete: if isAdmin();
    }

    match /workOrders/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isWorker()
          && userDoc().data.keys().hasAll(['workerId'])
          && userDoc().data.workerId in resource.data.workerIds);
      allow delete: if isAdmin();
    }

    match /inventoryItems/{id} {
      allow read, write: if isAdmin();
    }

    match /inventoryTransactions/{id} {
      allow read, write: if isAdmin();
    }

    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    match /workers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read, write: if isAdmin();
    }

    match /bills/{id} {
      allow read, write: if isAdmin();
    }

    match /ledgerEntries/{id} {
      allow read, write: if isAdmin();
    }
  }
}
